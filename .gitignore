# Runtime state
data/
*.log

# Node
node_modules/

# Local tooling
.claude/
.nwave/

# GoReleaser build output
/dist/

# Docs site (Astro Starlight) — generated content + build output
website/dist/
website/src/content/docs/
# Astro's generated content types. Regenerated by `astro sync` on every dev/build
# run, so committing them only produces churn: they encode the Astro version's
# codegen, and a patch bump rewrites them with no source change. They were
# tracked here but not in entra-emulator or fabric-emulator, which both ignore
# .astro/ — this matches those.
website/.astro/

# Go coverage profile (generated by CI and local test runs)
cover.out

# Portal (Svelte) test artifacts — portal/dist IS committed (go:embed)
portal/test-results/
portal/playwright-report/

# Parity version manifest — generated by website/scripts/sync-docs.mjs from git tags
website/src/data/parity-versions.json
