# Runtime state — the emulator's store, created at the repo root on first run.
# Anchored with a leading slash: a bare `data/` matches a directory of that name
# at ANY depth, which silently swallowed website/src/data/ too. That one is
# ignored deliberately by website/.gitignore; anything else landing in a nested
# data/ should be visible rather than disappear.
/data/
*.log

# Node
node_modules/

# Local tooling
.claude/
.nwave/

# GoReleaser build output
/dist/

# Docs site (Astro Starlight): its generated output — dist/, .astro/,
# src/content/docs/, src/data/parity-versions.json — is ignored by
# website/.gitignore, beside the thing it describes, as in entra-emulator and
# fabric-emulator. Listing it here as well would mean two places to keep in step.

# Go coverage profile (generated by CI and local test runs)
cover.out

# Portal (Svelte) test artifacts — portal/dist IS committed (go:embed)
portal/test-results/
portal/playwright-report/

# Python bytecode from scripts/
__pycache__/

# .NET build output from the e2e SDK witness suite
e2e/sdk/dotnet/bin/
e2e/sdk/dotnet/obj/
